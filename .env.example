# Copia este archivo como ".env" y llena los valores. NUNCA subas el .env a GitHub.

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=token_permanente_de_meta
WA_PHONE_ID=id_del_numero_de_telefono_en_meta
WA_VERIFY_TOKEN=inventa_una_palabra_secreta
WA_API_VERSION=v23.0
# Número del negocio, solo dígitos con indicativo de país (ej: 573013422266)
BUSINESS_NUMBER=57XXXXXXXXXX

# --- Gemini (gratis con límites): https://aistudio.google.com ---
GEMINI_API_KEY=tu_api_key
GEMINI_MODEL=gemini-3.8-flash

# --- Google Calendar / Meet ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Correo para avisar de cada reunión ---
GMAIL_USER=correo_que_envia@gmail.com
GMAIL_APP_PASSWORD=contrasena_de_aplicacion_de_16_letras
OWNER_EMAIL=correo_del_asesor_que_recibe_el_aviso

PORT=3000
